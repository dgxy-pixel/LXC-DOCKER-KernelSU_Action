#内核源码地址
KERNEL_SOURCE=https://github.com/dgxy-pixel/android_kernel_xiaomi_sdm660
#内核源码分支
KERNEL_SOURCE_BRANCH=lineage-20
#内核编译配置
KERNEL_CONFIG=vendor/platina_defconfig
#内核Image
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64
#参数
EXTRA_CMDS:LD=ld.lld
EXTRA_CMDT:LLVM=1
EXTRA_CMDU:LLVM_IAS=1

# 编译方案 A（clang+gcc）
METHOD_OK=A
USE_CUSTOM_CLANG=false
CUT_PYTHON=false

# 编译器 AOSP（4.19 内核适用）
CLANG_BRANCH=android-msm-bonito-4.9-android12-qpr1
CLANG_VERSION=clang-r383902

# 开启 LXC 和 DOCKER
LXC_DOCKER=true
LXC_PATCH=true
ANDROID_PARANOID_NETWORK_OFF=true

# 开启 KernelSU
ENABLE_KERNELSU=true
KERNELSU_TAG=main

# 额外配置
DISABLE-LTO=false
DISABLE_CC_WERROR=false
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=false

# KVM
ENABLE_KVM=false

# 缓存
ENABLE_CCACHE=true

# DTBO
NEED_DTBO=false

# 不构建 boot.img（用 AnyKernel3 卡刷包）
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=
